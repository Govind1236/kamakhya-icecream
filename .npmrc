; stream-json@1.9.1 is pinned exactly by directus/@directus-api and only used
; via StreamArray (NOT affected by GHSA-528h-pc64-c93x). The patched 3.5.0
; renamed StreamArray.js to stream-array.js, breaking directus' import. Keep
; 1.9.1 and only fail audit on high/critical advisories.
audit-level = high