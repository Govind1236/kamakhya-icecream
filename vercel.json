{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "functions": {
    "api/ssr.js": {
      "includeFiles": "dist/**",
      "memory": 1024,
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/(.*\\.(png|jpg|jpeg|gif|webp|svg|ico))", "destination": "/$1" },
    { "source": "/(.*)", "destination": "/api/ssr" }
  ]
}